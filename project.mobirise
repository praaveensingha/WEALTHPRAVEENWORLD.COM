          "_name": "header14",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header14\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\t<mbr-parameters>\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n\t\t<input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n\t\t<header>Wrap</header>\n\t\t<input type=\"range\" name=\"cardWidth\" title=\"Wrap Width\" min=\"6\" max=\"12\" value=\"10\" step=\"1\">\n\t\t<input type=\"color\" title=\"Wrap Bg\" name=\"wrapBgColor\" value=\"#ffffff\">\n\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"../_images/background3.jpg\" selected>\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#393193\">\n\t\t\t<input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n\t\t</fieldset>\n\t\t<header condition=\"bg.type === 'video'\">Fallback Image</header>\n\t\t<input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n\t</mbr-parameters>\n\n\t<div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\t<div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\t\t<div class=\"row justify-content-center\">\n\t\t\t<div class=\"card col-12 col-md-12 col-lg-{{cardWidth}}\">\n\t\t\t\t<div class=\"card-wrapper\">\n\t\t\t\t\t<div class=\"card-box align-center\">\n\t\t\t\t\t\t<h1 class=\"card-title mbr-fonts-style mb-4\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n\t\t\t\t\t\t\t<b>Disclaimer:Praveen Singh Founder praveen&nbsp; World</b></h1>\n\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">The content provided through this <b>Stock Market &amp; Mutual Fund Training Program by Praveen Singh Founder Praveen World Wealth </b>is for<b> educational and informational purposes only</b>. It is <b>not intended as investment, financial, legal, or tax advice</b>, nor should it be interpreted as a recommendation to buy, sell, or hold any financial instruments.\n<br>\n<br><b>Praveen Singh Founder Praveen  World&nbsp; Wealth operates as:</b><br><b><br></b><br><b>*&nbsp;</b>An <b>Authorized Person/Sub-Broker</b>&nbsp;under a SEBI-registered stockbroker, and\n<br><b>*</b> An <b>AMFI-registered Mutual Fund Distributor&nbsp;</b>under&nbsp;<b>SEBI</b>.<br>\n<br>We are <b>not SEBI-registered Investment Advisors</b>, and we do <b>not offer personalized financial advice, guaranteed return schemes, or portfolio management services</b>.<br>\n<br>&nbsp;<b>⚠️ Risk Disclosures:\n</b><br>\n<br><b>*</b> <b>Stock Market investments and trading involve risk.</b>&nbsp;Past performance is not indicative of future results. Prices of securities may fluctuate, and there is no assurance of profit.<br>\n<br><b>*</b> <b>Leverage, Options, and Derivatives trading&nbsp;</b>are high-risk strategies and should be undertaken with caution and proper risk management.<br>\n<br><b>* Mutual Fund investments are subject to market risks.&nbsp;</b>Please read all scheme-related documents carefully before investing.\n<br><br>All strategies, case studies, and examples shared in this course are based on <b>personal research, market experience, and general knowledge</b>. You are responsible for your own trading and investment decisions. We do <b>not accept liability</b>&nbsp;for any financial loss arising from the use of information provided.\n<br>\n<br>We recommend consulting with a <b>licensed professional or SEBI-registered Investment Advisor</b>&nbsp;for <b>personalized financial advice</b>.\n<br>\n<br>We wish you a <b>successful trading and investing journey</b>, but remember—<b>success depends on your own knowledge, continuous learning, research, discipline, and risk management</b>.\n<br>\n<br><b>Warm regards,<br>Praveen Singh</b><br>Founder – Praveen World<br>\n<br><br></p>\n\t\t\t\t\t\t<div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn mt-4\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-warning\" href=\"index.html#top\" data-app-placeholder=\"Type Text\">Start Trading Now</a></div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
